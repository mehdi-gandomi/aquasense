# --- API ---
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
SIMULATION_TICK_MS=1000
TELEMETRY_BATCH_MS=250
HISTORY_FLUSH_MS=5000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001
# Admin chrome: soft (colorful SaaS) | brutal (classic SCADA). Overridable in-app via Admin look select.
# NEXT_PUBLIC_ADMIN_LOOK=soft

# --- MQTT ---
# Local: docker compose -f infra/docker-compose.yml up -d
# Dokploy: mosquitto + mqtt-sim are in docker-compose.yml; set MQTT_ENABLED=true to use them.
MQTT_ENABLED=false
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_WATCHDOG_MS=10000

# --- MySQL ---
DB_ENABLED=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=aquasense

JWT_SECRET=aquasense-dev-jwt-change-me
JWT_EXPIRES=7d

# --- Assistant (OpenAI-compatible, optional) ---
# Leave empty until your LLM API exists. The chat UI still works with a local plant brief.
# LLM_BASE_URL=http://localhost:8000
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# --- Dokploy / production (set in Dokploy Environment, not in this file) ---
# CORS_ORIGIN=https://app.example.com
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXT_PUBLIC_WS_URL=https://api.example.com
# MYSQL_PASSWORD=...
# JWT_SECRET=...
# MQTT_ENABLED=false
